# Required
DATABASE_URL=postgresql://user:password@host:6543/postgres

# Optional - TTS/STT via ElevenLabs (falls back to browser native APIs if not set)
ELEVENLABS_API_KEY=sk_...

# Optional - Vector embeddings (at least one required for semantic search)
COHERE_API_KEY=...
JINA_API_KEY=...

# Optional - CORS origins (comma-separated, default: *)
CORS_ORIGINS=https://your-app.vercel.app
